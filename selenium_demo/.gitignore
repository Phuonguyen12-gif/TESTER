# Secrets — không bao giờ commit .env thật
.env

# Artifact sinh ra khi chạy test (ảnh fail mới ở root, demo regenerate,
# report.html mới nhất). Evidence đã chuẩn hóa trong screenshots/phase_N/
# thì ĐƯỢC commit.
screenshots/*.png
screenshots/demo/
reports/*.html

# Python cache
__pycache__/
.pytest_cache/
*.pyc
