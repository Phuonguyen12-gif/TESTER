# Copy file này thành .env để override cấu hình mặc định.
# KHÔNG commit file .env thật.

# URL trang cần kiểm thử
BASE_URL=https://www.saucedemo.com/

# Trình duyệt (hiện hỗ trợ: chrome)
BROWSER=chrome

# Chạy headless: true/false (flag --headless của pytest ưu tiên hơn)
HEADLESS=false

# Thời gian chờ explicit wait tối đa (giây)
TIMEOUT=10

# Kích thước cửa sổ trình duyệt: width,height
WINDOW_SIZE=1280,900
